# ========================================================
# Variables de Entorno - Frontend CNM
# ========================================================

# URL base del Backend REST (Spring Boot / API Gateway)
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL del proyecto Supabase (o dominio personalizado / reverse proxy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave pública anónima de Supabase (Publishable Key / Anon Key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ID de cliente de Google OAuth (Google Identity Services / GIS)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# URL pública de la imagen de logo (opcional, fallback local si no se define)
NEXT_PUBLIC_LOGO_URL=
