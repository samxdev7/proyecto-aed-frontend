# ========================================================
# Variables de Entorno - Frontend CNM
# ========================================================

# URL base del Backend REST (Spring Boot / API Gateway, incluye /api)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# URL del proyecto Supabase (o dominio personalizado / reverse proxy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave pública anónima de Supabase (Publishable Key / Anon Key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ID de cliente de Google OAuth (Google Identity Services / GIS)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# URL pública de la imagen de logo (opcional, fallback local si no se define)
NEXT_PUBLIC_LOGO_URL=

# ========================================================
# Relay de Correo Serverless (Nodemailer con Google SMTP en Vercel)
# ========================================================
# Secreto interno compartido para autorizar peticiones desde el backend (Render)
INTERNAL_EMAIL_SECRET=tu_clave_secreta_compartida

# Configuración SMTP de Google (despacho saliente permitido en Vercel puerto 587)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
